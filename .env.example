# Supply these through your shell or the deployment platform. Local development:
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:3000
BIND_ADDR=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://workspace:CHANGE_ME@127.0.0.1:5432/workspace
# Explicit loopback-only sign-in preview. Disable for hosted deployments.
DEV_LOGIN_LINKS=1
# Production email
# RESEND_API_KEY=
# MAIL_FROM=
# Optional read-only GitHub App
# WORKSPACE_GITHUB_APP_SLUG=
# WORKSPACE_GITHUB_CLIENT_ID=
# WORKSPACE_GITHUB_CLIENT_SECRET=
# WORKSPACE_GITHUB_TOKEN_KEY=    (base64-encoded random 32 bytes)
# WORKSPACE_GITHUB_WEBHOOK_SECRET=
# Optional Stripe subscription billing
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PLUS=
# STRIPE_PRICE_MAX=
# STRIPE_ENABLE_LIVE=false
# Optional operator endpoints
# OPS_METRICS_TOKEN=
# SUPPORT_EMAIL=
# STATUS_URL=
